# Zenplanner credentials for CrossFit Pro1
ZENPLANNER_BASE_URL=https://crossfitpro1.sites.zenplanner.com
ZENPLANNER_EMAIL=your@email.com
ZENPLANNER_PASSWORD=your_password
# Person ID — find it by logging into Zenplanner via browser and checking the URL:
# https://crossfitpro1.sites.zenplanner.com/calendar.cfm?calendarType=PERSON:<THIS_PART>
ZENPLANNER_PERSON_ID=YOUR_PERSON_ID_HERE

# Optional: member API (studio/api2) settings — defaults suit CrossFit Pro1
# Partition/org id of your gym
ZENPLANNER_ORG_ID=12cdc08f-eeed-4601-85a8-cf36e8486008
# Display timezone used for day boundaries in schedule lookups
ZENPLANNER_TZ=America/Toronto
